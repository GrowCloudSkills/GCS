---
// Search component with Pagefind - Fixed version
// This component runs only in the browser after Pagefind is available
---

<div class="pagefind-container">
  <div class="search-box">
    <input 
      type="text" 
      id="search-input" 
      placeholder="🔍 Search posts..." 
      class="search-input"
      aria-label="Search posts"
    />
  </div>
  <div id="search-results" class="search-results hidden"></div>
</div>

<script is:inline>
  // Wait for Pagefind to be available, then initialize
  async function initPagefindSearch() {
    // Wait for the page to fully load
    if (document.readyState !== 'complete') {
      window.addEventListener('load', initPagefindSearch);
      return;
    }

    try {
      // Check if pagefind is available
      if (typeof window.pagefind === 'undefined') {
        // Wait a moment and try again
        setTimeout(initPagefindSearch, 100);
        return;
      }

      await window.pagefind.init();

      const searchInput = document.getElementById('search-input');
      const searchResults = document.getElementById('search-results');

      if (!searchInput || !searchResults) return;

      let searchTimeout;
      searchInput.addEventListener('input', async (e) => {
        clearTimeout(searchTimeout);
        const query = e.target.value.trim();

        if (!query) {
          searchResults.classList.add('hidden');
          return;
        }

        searchTimeout = setTimeout(async () => {
          try {
            const results = await window.pagefind.search(query);
            
            if (!results.results || results.results.length === 0) {
              searchResults.innerHTML = `<div class="no-results"><p>No posts found matching "${query}"</p></div>`;
            } else {
              searchResults.innerHTML = results.results
                .slice(0, 10)
                .map((result) => `
                  <a href="${result.url}" class="result-item">
                    <div class="result-title">${result.meta.title || 'Untitled'}</div>
                    <div class="result-excerpt">${result.excerpt || 'No description'}</div>
                  </a>
                `)
                .join('');
            }

            searchResults.classList.remove('hidden');
          } catch (error) {
            console.error('Search error:', error);
          }
        }, 300);
      });

      // Close results when clicking outside
      document.addEventListener('click', (e) => {
        if (!e.target.closest('.pagefind-container')) {
          searchResults.classList.add('hidden');
        }
      });

      // Close results on Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          searchResults.classList.add('hidden');
          searchInput.value = '';
        }
      });

    } catch (error) {
      console.error('Pagefind initialization error:', error);
    }
  }

  // Start initialization
  initPagefindSearch();
</script>

<style>
  .pagefind-container {
    position: relative;
    width: 100%;
  }

  .search-box {
    width: 100%;
  }

  .search-input {
    width: 100%;
    padding: 0.85rem 1.2rem;
    font-size: 1rem;
    border: 2px solid #06B6D4;
    border-radius: 8px;
    font-family: inherit;
    background: white;
    transition: all 0.3s ease;
  }

  .search-input:hover {
    border-color: #0F3B66;
  }

  .search-input:focus {
    outline: none;
    border-color: #0F3B66;
    box-shadow: 0 0 0 4px rgba(6, 182, 212, 0.15);
  }

  .search-results {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    max-height: 500px;
    overflow-y: auto;
    background: white;
    border: 1px solid #D1E0ED;
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    z-index: 1000;
  }

  .search-results.hidden {
    display: none;
  }

  .result-item {
    display: block;
    padding: 1rem 1.2rem;
    border-bottom: 1px solid #E8EEF5;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s ease;
  }

  .result-item:hover {
    background: #F0F7FB;
    padding-left: 1.4rem;
  }

  .result-item:last-child {
    border-bottom: none;
  }

  .result-title {
    font-weight: 700;
    color: #0F3B66;
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
  }

  .result-excerpt {
    font-size: 0.85rem;
    color: #64748B;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .no-results {
    padding: 2rem 1.2rem;
    text-align: center;
    color: #64748B;
  }

  .search-results::-webkit-scrollbar {
    width: 8px;
  }

  .search-results::-webkit-scrollbar-track {
    background: #F0F7FB;
  }

  .search-results::-webkit-scrollbar-thumb {
    background: #06B6D4;
    border-radius: 4px;
  }
</style>