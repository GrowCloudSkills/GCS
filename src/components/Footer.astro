<style>
  .footer {
    background: #ffffff;
    border-top: 1px solid #e0e0e0;
    margin-top: 4rem;
    padding: 3rem 0;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* TOP SECTION - 2 COLUMNS */
  .footer-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 3rem;
    margin-bottom: 2rem;
    padding-bottom: 2rem;
  }

  /* LEFT: BRANDING */
  .footer-branding {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: #003b66;
    font-weight: 700;
    width: fit-content;
    transition: all 0.2s;
  }

  .footer-logo:hover {
    transform: scale(1.02);
    color: #0091b8;
  }

  .logo-badge {
    background: linear-gradient(135deg, #0091b8 0%, #06b6d4 100%);
    color: white;
    padding: 0.45rem 0.75rem;
    border-radius: 6px;
    font-weight: 900;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    box-shadow: 0 2px 8px rgba(6, 182, 212, 0.25);
  }

  .logo-text {
    color: #003b66;
    font-weight: 900;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }

  .footer-description {
    color: #666;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  /* RIGHT: NAVIGATION */
  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .section-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: #003b66;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-nav a {
    color: #666;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    transition: all 0.2s;
  }

  .footer-nav a:hover {
    color: #0091b8;
    transform: translateX(4px);
  }

  /* DIVIDER */
  .footer-divider {
    display: none;
  }

  /* SOCIAL ICONS - CENTERED */
  .footer-social {
    display: flex;
    justify-content: center;
    margin-bottom: 2rem;
    padding-bottom: 2rem;
  }

  .social-icons {
    display: flex;
    gap: 1.25rem;
    align-items: center;
    justify-content: center;
  }

  .social-icons a {
    display: inline-flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    color: #003b66;
    background: #f5f5f5;
    border: 2px solid #e0e0e0;
    border-radius: 50%;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .social-icons a:hover {
    color: white;
    background: #0091b8;
    border-color: #0091b8;
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 145, 184, 0.2);
  }

  .social-icons svg {
    width: 20px;
    height: 20px;
  }

  /* BOTTOM: COPYRIGHT */
  .footer-bottom {
    text-align: center;
    color: #999;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .copyright-text {
    margin: 0 0 0.75rem;
    font-weight: 600;
    color: #666;
  }

  .copyright-disclaimer {
    margin: 0;
    color: #aaa;
    font-size: 0.8rem;
  }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    .footer {
      padding: 2rem 0;
      margin-top: 3rem;
    }

    .footer-container {
      padding: 0 1.5rem;
    }

    .footer-top {
      grid-template-columns: 1fr;
      gap: 2rem;
      margin-bottom: 1.5rem;
      padding-bottom: 1.5rem;
    }

    .footer-social {
      margin-bottom: 1.5rem;
      padding-bottom: 1.5rem;
    }

    .social-icons {
      gap: 1rem;
    }

    .social-icons a {
      width: 40px;
      height: 40px;
    }

    .social-icons svg {
      width: 18px;
      height: 18px;
    }

    .footer-nav {
      gap: 0.5rem;
    }

    .footer-nav a {
      font-size: 0.9rem;
    }

    .footer-description {
      font-size: 0.9rem;
    }

    .copyright-text {
      font-size: 0.8rem;
    }

    .copyright-disclaimer {
      font-size: 0.75rem;
    }
  }

  @media (max-width: 480px) {
    .footer {
      padding: 1.5rem 0;
      margin-top: 2rem;
    }

    .footer-container {
      padding: 0 1rem;
    }

    .footer-top {
      gap: 1.5rem;
      margin-bottom: 1.25rem;
      padding-bottom: 1.25rem;
    }

    .logo-text {
      font-size: 0.95rem;
    }

    .logo-badge {
      font-size: 0.75rem;
      padding: 0.35rem 0.65rem;
    }

    .section-title {
      font-size: 0.85rem;
    }

    .footer-nav a {
      font-size: 0.85rem;
    }

    .footer-description {
      font-size: 0.85rem;
    }

    .footer-divider {
      margin: 1.25rem 0;
    }

    .footer-social {
      margin-bottom: 1.25rem;
      padding-bottom: 1.25rem;
    }

    .social-icons {
      gap: 0.75rem;
    }

    .social-icons a {
      width: 36px;
      height: 36px;
    }

    .social-icons svg {
      width: 16px;
      height: 16px;
    }

    .copyright-text {
      font-size: 0.75rem;
    }

    .copyright-disclaimer {
      font-size: 0.7rem;
    }
  }
</style>
