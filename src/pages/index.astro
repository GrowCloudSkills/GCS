---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const formatShort = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const readMinutes = (body: string): number =>
  Math.max(1, Math.ceil(body.trim().split(/\s+/).length / 200));

const depth = (mins: number) =>
  mins >= 18
    ? { label: 'Deep', bars: '▰▰▰', cls: 'd3' }
    : mins >= 9
    ? { label: 'Applied', bars: '▰▰▱', cls: 'd2' }
    : { label: 'Foundational', bars: '▰▱▱', cls: 'd1' };

const recentPosts = allPosts.slice(0, 5);

const cardData = (post: typeof allPosts[number]) => {
  const mins = readMinutes(post.body);
  return { mins, tier: depth(mins) };
};

// Get unique tags from all posts
const allTags = [...new Set(allPosts.flatMap(post => post.data.tags || []))];

const modules = [
  { name: 'Core HR', icon: '👥', color: 'blue' },
  { name: 'Payroll', icon: '💰', color: 'teal' },
  { name: 'Time & Labor', icon: '⏱️', color: 'blue' },
  { name: 'Absence Mgmt', icon: '📅', color: 'teal' },
  { name: 'Benefits', icon: '🏥', color: 'blue' },
  { name: 'Recruiting', icon: '📋', color: 'teal' },
];

const paths = [
  {
    title: 'Technical',
    icon: '💻',
    description: 'Fast Formulas, SQL, BIP, HDL, integration patterns',
    href: '/technical',
    color: 'primary'
  },
  {
    title: 'Functional',
    icon: '⚙️',
    description: 'Configuration, setup, best practices across modules',
    href: '/functional',
    color: 'accent'
  },
  {
    title: 'Trainings',
    icon: '📚',
    description: 'Step-by-step guides, tutorials, skill development',
    href: '/trainings',
    color: 'accent'
  },
];

const author = {
  name: 'Vaibhav Chavan',
  bio: 'Oracle Fusion HCM Specialist and Solutions Consultant',
  image: '/images/authors/vaibhav-chavan.jpg'
};
---

<BaseLayout title="GrowCloudSkills - Oracle Fusion HCM Knowledge Hub">
  <div class="hp">
    <!-- ══════════ HERO BAND ══════════ -->
    <section class="hp-shell">
      <div class="hero-band">
        <div class="hero-grid">
          <div class="hero-content">
            <div class="hero-eyebrow">Oracle Fusion HCM Cloud</div>
            <h1>Master Enterprise <span class="accent">HCM Implementation</span></h1>
            <p class="hero-lead">
              Deep technical expertise and functional guidance for Oracle Fusion HCM. From Fast Formulas to multi-country architectures, learn production-ready solutions from real implementations.
            </p>
            <div class="hero-cta">
              <a href="#learning-paths" class="btn btn--primary">Explore Learning Paths</a>
              <a href="/technical" class="btn btn--secondary">Browse Articles</a>
            </div>
          </div>
          
          <div class="hero-visual">
            <div class="ecosystem">
              <div class="core">
                <div class="core-circle">HCM Cloud</div>
                <div class="module module-1">Core HR</div>
                <div class="module module-2">Payroll</div>
                <div class="module module-3">Time & Labor</div>
                <div class="module module-6">Absence</div>
                <div class="module module-5">Recruiting</div>
                <div class="module module-4">Benefits</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══════════ MAIN WRAPPER (Content + Sidebar) ══════════ -->
    <section class="hp-shell main-wrapper">
      <!-- LEFT: Main Content -->
      <main class="main-content">
        
        <!-- ══════════ WHAT IS ORACLE FUSION HCM ══════════ -->
        <section class="section-compact section-what">
          <div class="section-header">
            <div class="section-kicker">Overview</div>
            <h2>What is Oracle Fusion HCM Cloud?</h2>
            <p class="section-lead">
              Enterprise human capital management system powering global organizations.
            </p>
          </div>

          <div class="capabilities-compact">
            <div class="capability-compact">
              <span class="cap-icon">🌍</span>
              <h3>Global Scalability</h3>
              <p>Multi-country, multi-currency implementations with localized compliance</p>
            </div>
            <div class="capability-compact">
              <span class="cap-icon">🔧</span>
              <h3>Deep Configuration</h3>
              <p>Flexible architecture with Fast Formulas, HDL, and business rules engine</p>
            </div>
            <div class="capability-compact">
              <span class="cap-icon">📊</span>
              <h3>Real-time Analytics</h3>
              <p>OTBI reporting, Redwood UI dashboards, and integrated BI</p>
            </div>
            <div class="capability-compact">
              <span class="cap-icon">🔗</span>
              <h3>Enterprise Integration</h3>
              <p>REST APIs, HCM Data Loader, and integration frameworks</p>
            </div>
          </div>

          <div class="modules-grid">
            {modules.map((mod) => (
              <div class={`module-card module-card--${mod.color}`}>
                <span class="mod-icon">{mod.icon}</span>
                <h4>{mod.name}</h4>
              </div>
            ))}
          </div>
        </section>

        <!-- ══════════ LEARNING PATHS ══════════ -->
        <section class="section-compact section-paths" id="learning-paths">
          <div class="section-header">
            <div class="section-kicker">Three Ways to Learn</div>
            <h2>Choose Your Learning Path</h2>
          </div>

          <div class="paths-grid-compact">
            {paths.map((path) => (
              <a href={path.href} class={`path-card-compact path-card--${path.color}`}>
                <div class="path-icon">{path.icon}</div>
                <h3>{path.title}</h3>
                <p>{path.description}</p>
                <span class="path-arrow">Explore →</span>
              </a>
            ))}
          </div>
        </section>

        <!-- ══════════ LATEST ARTICLES ══════════ -->
        <section class="section-compact section-articles">
          <div class="section-header">
            <div class="section-kicker">Knowledge Base</div>
            <h2>Latest Articles</h2>
            <p class="section-lead">{allPosts.length} in-depth guides available</p>
          </div>

          {allPosts.length === 0 ? (
            <p class="empty">No articles published yet. Check back soon!</p>
          ) : (
            <div class="articles-list-compact">
              {allPosts.slice(0, 8).map((post) => {
                const d = cardData(post);
                return (
                  <a href={`/posts/${post.slug}`} class="article-item-compact">
                    <div class="article-item-header">
                      <h3>{post.data.title}</h3>
                    </div>
                    <div class="article-item-meta">
                      <span class="meta-item">{d.mins} min</span>
                      <span class={`meta-item tier ${d.tier.cls}`}>{d.tier.label}</span>
                      <span class="meta-item">{formatShort(post.data.pubDate)}</span>
                    </div>
                  </a>
                );
              })}
            </div>
          )}

          <div class="view-all-compact">
            <a href="/technical" class="btn btn--primary">View All Articles</a>
          </div>
        </section>

      </main>

      <!-- RIGHT: SIDEBAR -->
      <aside class="sidebar">
        
        <!-- SEARCH -->
        <div class="sidebar-box">
          <h3>Search</h3>
          <form class="search-form">
            <input type="text" placeholder="Search articles..." name="q">
            <button type="submit">🔍</button>
          </form>
        </div>

        <!-- LATEST POSTS -->
        <div class="sidebar-box">
          <h3>Latest Posts</h3>
          <div class="recent-posts">
            {recentPosts.map((post) => (
              <a href={`/posts/${post.slug}`} class="recent-post-item">
                <div class="recent-post-title">{post.data.title}</div>
                <div class="recent-post-date">{formatShort(post.data.pubDate)}</div>
              </a>
            ))}
          </div>
        </div>

        <!-- AUTHOR BIO -->
        <div class="sidebar-box author-box">
          <h3>Author</h3>
          <div class="author-avatar">
            <img 
              src={author.image} 
              alt={author.name}
              onerror="this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22%3E%3Crect fill=%22%230F3B66%22 width=%22100%22 height=%22100%22/%3E%3Ctext x=%2250%25%22 y=%2250%25%22 text-anchor=%22middle%22 dy=%22.3em%22 font-size=%2250%22 fill=%22white%22%3EVC%3C/text%3E%3C/svg%3E'"
            >
          </div>
          <h4>{author.name}</h4>
          <p class="author-bio">{author.bio}</p>
          <a href="/about" class="author-link">View Profile →</a>
        </div>

        <!-- TAGS -->
        {allTags.length > 0 && (
          <div class="sidebar-box">
            <h3>Topics</h3>
            <div class="tags-cloud">
              {allTags.slice(0, 12).map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>
        )}

        <!-- DIGITAL PRODUCTS -->
        <div class="sidebar-box products-box">
          <h3>Resources</h3>
          <div class="products-list">
            <div class="product-item">
              <span class="product-icon">📚</span>
              <div class="product-name">Implementation Guide</div>
            </div>
            <div class="product-item">
              <span class="product-icon">⚡</span>
              <div class="product-name">Fast Formula Mastery</div>
            </div>
            <div class="product-item">
              <span class="product-icon">📊</span>
              <div class="product-name">Config Checklist</div>
            </div>
          </div>
        </div>

      </aside>
    </section>

    <!-- ══════════ CTA SECTION ══════════ -->
    <section class="hp-shell section-cta">
      <div class="cta-box">
        <h2>Ready to deepen your Oracle Fusion HCM expertise?</h2>
        <p>Start with Technical deep-dives, Functional configurations, or guided Trainings.</p>
        <div class="cta-buttons">
          <a href="/technical" class="btn btn--primary">Technical Articles</a>
          <a href="/functional" class="btn btn--secondary">Functional Guides</a>
          <a href="/trainings" class="btn btn--secondary">Trainings</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .hp {
    --primary: #0F3B66;
    --primary-light: #E8F2F8;
    --accent: #06B6D4;
    --accent-light: #CCF0FF;
    --text-strong: #0F3B66;
    --text-primary: #1E293B;
    --text-muted: #334155;
    --text-faint: #64748B;
    --surface: #FFFFFF;
    --bg: #F0F7FB;
    --border: #D1E0ED;
    
    background: var(--bg);
    color: var(--text-primary);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 15px;
    line-height: 1.68;
    padding-block: 0;
  }

  .hp * {
    box-sizing: border-box;
  }

  .hp-shell {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ═══════════════════════════════════
     HERO SECTION
     ═══════════════════════════════════ */

  .hero-band {
    background: linear-gradient(135deg, rgba(15, 59, 102, 0.03) 0%, rgba(6, 182, 212, 0.03) 100%);
    border: 1px solid var(--border);
    border-radius: 20px;
    overflow: hidden;
    margin: 3rem 0 2.5rem;
    position: relative;
  }

  .hero-band::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, var(--primary) 0%, var(--accent) 100%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    padding: 3rem;
  }

  .hero-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .hero-eyebrow::after {
    content: '';
    height: 2px;
    flex: 1;
    max-width: 80px;
    background: linear-gradient(90deg, var(--accent), transparent);
    border-radius: 2px;
  }

  .hp h1 {
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--text-strong);
    margin: 0 0 1rem;
  }

  .hp h1 .accent {
    color: var(--accent);
  }

  .hero-lead {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    max-width: 55ch;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn--primary {
    background: var(--primary);
    color: white;
  }

  .btn--primary:hover {
    background: var(--text-strong);
    transform: translateY(-2px);
  }

  .btn--secondary {
    background: var(--primary-light);
    color: var(--primary);
    border: 1px solid var(--border);
  }

  .btn--secondary:hover {
    background: white;
    border-color: var(--primary);
  }

  /* Ecosystem Visual */
  .hero-visual {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ecosystem {
    width: 100%;
    height: 300px;
    position: relative;
  }

  .core {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .core-circle {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), var(--accent));
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 13px;
    text-align: center;
    box-shadow: 0 8px 30px rgba(15, 59, 102, 0.2);
    z-index: 10;
  }

  .module {
    position: absolute;
    width: 85px;
    height: 45px;
    background: var(--surface);
    border: 2px solid var(--primary);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 700;
    color: var(--primary);
    text-align: center;
    padding: 0.4rem;
  }

  .module-1 { top: 0; left: 50%; transform: translateX(-50%); }
  .module-2 { top: 25px; right: 0; }
  .module-3 { bottom: 25px; right: 0; }
  .module-4 { bottom: 0; left: 50%; transform: translateX(-50%); }
  .module-5 { bottom: 25px; left: 0; }
  .module-6 { top: 25px; left: 0; }

  /* ═══════════════════════════════════
     MAIN WRAPPER (Content + Sidebar)
     ═══════════════════════════════════ */

  .main-wrapper {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }

  .main-content {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  /* ═══════════════════════════════════
     SECTION STYLES (COMPACT)
     ═══════════════════════════════════ */

  .section-compact {
    /* No padding override, uses defaults */
  }

  .section-header {
    margin-bottom: 2rem;
    text-align: left;
  }

  .section-kicker {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .hp h2 {
    font-size: clamp(1.3rem, 2.5vw, 1.8rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text-strong);
    margin: 0 0 0.75rem;
  }

  .section-lead {
    font-size: 0.95rem;
    color: var(--text-muted);
    max-width: 65ch;
    margin: 0 ;
    line-height: 1.6;
    text-align: left;
  }

  /* What Section */
  .section-what {
  }

  .capabilities-compact {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .capability-compact {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.5rem;
    transition: all 0.2s ease;
  }

  .capability-compact:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(6, 182, 212, 0.1);
  }

  .cap-icon {
    font-size: 2rem;
    display: block;
    margin-bottom: 0.75rem;
  }

  .capability-compact h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-strong);
    margin: 0 0 0.4rem;
  }

  .capability-compact p {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
  }

  .modules-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.75rem;
  }

  .module-card {
    background: var(--surface);
    border: 2px solid var(--border);
    border-radius: 10px;
    padding: 1rem;
    text-align: center;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .module-card--blue {
    border-color: var(--primary);
    background: var(--primary-light);
  }

  .module-card--blue:hover {
    transform: translateY(-2px);
  }

  .module-card--teal {
    border-color: var(--accent);
    background: var(--accent-light);
  }

  .module-card--teal:hover {
    transform: translateY(-2px);
  }

  .mod-icon {
    font-size: 1.75rem;
    display: block;
    margin-bottom: 0.4rem;
  }

  .module-card h4 {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-strong);
    margin: 0;
  }

  /* Learning Paths */
  .section-paths {
  }

  .paths-grid-compact {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .path-card-compact {
    background: var(--surface);
    border: 2px solid var(--border);
    border-radius: 12px;
    padding: 1.75rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s ease;
    position: relative;
    overflow: hidden;
  }

  .path-card-compact::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, var(--primary), var(--accent));
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .path-card-compact:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(6, 182, 212, 0.12);
  }

  .path-card-compact:hover::before {
    opacity: 1;
  }

  .path-icon {
    font-size: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .path-card-compact h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-strong);
    margin: 0 0 0.5rem;
  }

  .path-card-compact p {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0 0 1rem;
    line-height: 1.5;
  }

  .path-arrow {
    font-weight: 600;
    color: var(--accent);
    transition: all 0.2s ease;
  }

  .path-card-compact:hover .path-arrow {
    transform: translateX(4px);
    display: inline-block;
  }

  /* Articles Section */
  .section-articles {
  }

  .articles-list-compact {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .article-item-compact {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.2rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .article-item-compact:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(6, 182, 212, 0.1);
  }

  .article-item-header h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-strong);
    margin: 0;
    line-height: 1.3;
  }

  .article-item-meta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    font-size: 0.8rem;
    color: var(--text-faint);
  }

  .meta-item {
    display: flex;
    align-items: center;
  }

  .meta-item.tier {
    color: var(--accent);
    font-weight: 600;
  }

  .view-all-compact {
    text-align: center;
  }

  /* ═══════════════════════════════════
     SIDEBAR
     ═══════════════════════════════════ */

  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .sidebar-box {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.5rem;
  }

  .sidebar-box h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-strong);
    margin: 0 0 1rem;
  }

  .sidebar-box h4 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-strong);
    margin: 0 0 0.5rem;
  }

  /* Search Form */
  .search-form {
    display: flex;
    gap: 0.5rem;
  }

  .search-form input {
    flex: 1;
    padding: 0.65rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.9rem;
    transition: all 0.2s;
  }

  .search-form input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.1);
  }

  .search-form button {
    padding: 0.65rem 1rem;
    background: var(--primary);
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 600;
    transition: all 0.2s;
  }

  .search-form button:hover {
    background: var(--text-strong);
  }

  /* Recent Posts */
  .recent-posts {
    display: flex;
    flex-direction: column;
