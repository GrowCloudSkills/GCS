    padding: 3rem;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }

  .legal-content h1 {
    color: #0F3B66;
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    font-weight: 800;
  }

  .last-updated {
    color: #666;
    font-size: 0.95rem;
    margin-bottom: 2rem;
    border-bottom: 2px solid #E8F2F8;
    padding-bottom: 1rem;
  }

  .legal-content section {
    margin: 2.5rem 0;
  }

  .legal-content h2 {
    color: #0F3B66;
    font-size: 1.5rem;
    margin: 1.5rem 0 1rem;
    font-weight: 700;
  }

  .legal-content h3 {
    color: #003b66;
    font-size: 1.1rem;
    margin: 1.25rem 0 0.75rem;
    font-weight: 700;
  }

  .legal-content h4 {
    color: #334155;
    font-size: 1rem;
    margin: 1rem 0 0.5rem;
    font-weight: 700;
  }

  .legal-content p {
    color: #334155;
    line-height: 1.8;
    margin: 0 0 1rem;
    font-size: 1rem;
  }

  .legal-content ul {
    margin: 1rem 0 1.5rem;
    padding-left: 2rem;
  }

  .legal-content li {
    color: #334155;
    margin-bottom: 0.75rem;
    line-height: 1.6;
  }

  .legal-content a {
    color: #06B6D4;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .legal-content a:hover {
    color: #0F3B66;
    text-decoration: underline;
  }

  .legal-footer {
    background: #F0F7FB;
    border-left: 4px solid #06B6D4;
    padding: 1.5rem;
    margin-top: 3rem;
    border-radius: 8px;
  }

  .legal-footer p {
    margin: 0;
    font-size: 0.9rem;
    color: #666;
