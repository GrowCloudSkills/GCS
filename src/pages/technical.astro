---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const technicalPosts = allPosts
	.filter(post => post.data.category === 'Technical')
	.sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());

// Get all unique tags from technical posts
const allTags = [...new Set(technicalPosts.flatMap(post => post.data.tags || []))];

// 🎯 NEW: Get the selected tag from URL query parameter
const selectedTag = new URL(Astro.request.url).searchParams.get('tag');

// 🎯 NEW: Filter posts based on selected tag
const filteredPosts = selectedTag
	? technicalPosts.filter(post => post.data.tags?.includes(selectedTag))
	: technicalPosts;
---

<BaseLayout title="Technical Articles" description="In-depth technical guides for Oracle Fusion HCM">
	<div class="container">
		<div class="section-header">
			<h1>Technical Articles</h1>
			<p class="section-description">
				Deep-dive technical guides, architecture patterns, BIP and OTBI, SQL queries, and implementation details 
				for Oracle Fusion HCM professionals.
			</p>
			<!-- 🎯 NEW: Show active filter tag -->
			{selectedTag && (
				<div class="active-filter">
					<p>Showing posts tagged with <strong>"{selectedTag}"</strong></p>
					<a href="/technical" class="clear-filter">← Clear filter</a>
				</div>
			)}
		</div>

		<div class="content-area">
			<!-- Filter Section -->
			<aside class="sidebar">
				<div class="filter-box">
					<h3>Filter by Topic</h3>
					<ul class="filter-list">
						<li>
							<a href="/technical" class={`filter-link ${!selectedTag ? 'active' : ''}`}>
								All ({technicalPosts.length})
							</a>
						</li>
						{allTags.map(tag => {
							const postsWithTag = technicalPosts.filter(post => 
								post.data.tags?.includes(tag)
							);
							const isActive = selectedTag === tag;
							return (
								<li>
									<a 
										href={`/technical?tag=${tag}`} 
										class={`filter-link ${isActive ? 'active' : ''}`}
									>
										{tag} ({postsWithTag.length})
									</a>
								</li>
							);
						})}
					</ul>
				</div>
			</aside>

			<!-- Posts List -->
			<main class="posts-main">
				<div class="posts-grid">
					{filteredPosts.map(post => (
						<article class="post-card">
							<div class="post-header">
								<span class="category-badge">Technical</span>
								<span class="date">{new Date(post.data.pubDate).toLocaleDateString()}</span>
							</div>
							
							<h2>
								<a href={`/posts/${post.slug}`}>{post.data.title}</a>
							</h2>
							
							<p class="post-description">{post.data.description}</p>
							
							<div class="post-tags">
								{post.data.tags?.map(tag => (
									<a href={`/technical?tag=${tag}`} class="tag-link">
										<span class="tag">{tag}</span>
									</a>
								))}
							</div>
							
							<a href={`/posts/${post.slug}`} class="read-more">
								Read Article →
							</a>
						</article>
					))}
				</div>

				{filteredPosts.length === 0 && (
					<div class="empty-state">
						<p>No articles found with tag "<strong>{selectedTag}</strong>"</p>
						<a href="/technical" class="empty-state-link">View all technical articles</a>
					</div>
				)}
			</main>
		</div>
	</div>
</BaseLayout>

<style>
	.container {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 24px;
	}

	.section-header {
		margin: 3rem 0 2rem;
		text-align: center;
		padding: 0 0 2rem;
		border-bottom: 1px solid var(--border);
	}

	.section-header h1 {
		font-size: 2.5rem;
		font-weight: 800;
		color: var(--ink-strong);
		margin: 0 0 0.5rem;
	}

	.section-description {
		font-size: 1.05rem;
		color: var(--ink-muted);
		max-width: 600px;
		margin: 0 auto;
		line-height: 1.6;
	}

	/* 🎯 NEW: Styles for active filter indicator */
	.active-filter {
		margin-top: 1.5rem;
		padding: 1rem;
		background: rgba(6, 182, 212, 0.08);
		border: 1px solid rgba(6, 182, 212, 0.3);
		border-radius: 8px;
		text-align: center;
	}

	.active-filter p {
		font-size: 13px;
		color: var(--ink-muted);
		margin: 0 0 0.5rem;
	}

	.active-filter strong {
		color: var(--primary);
		font-weight: 700;
	}

	.clear-filter {
		display: inline-block;
		font-size: 12px;
		color: var(--primary);
		text-decoration: none;
		font-weight: 600;
		transition: all 0.2s;
	}

	.clear-filter:hover {
		transform: translateX(-3px);
	}

	.content-area {
		display: grid;
		grid-template-columns: 220px 1fr;
		gap: 2rem;
		margin: 2rem 0;
	}

	.sidebar {
		position: sticky;
		top: 80px;
		height: fit-content;
	}

	.filter-box {
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: 10px;
		padding: 1.5rem;
	}

	.filter-box h3 {
		font-size: 14px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--primary);
		margin: 0 0 1rem;
	}

	.filter-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.filter-list li {
		margin-bottom: 0.5rem;
	}

	.filter-link {
		display: block;
		font-size: 13px;
		color: var(--ink-muted);
		text-decoration: none;
		padding: 6px 10px;
		border-radius: 4px;
		transition: all 0.15s;
	}

	.filter-link:hover {
		color: var(--primary);
		background: var(--primary-soft);
	}

	/* 🎯 NEW: Enhanced active state styling */
	.filter-link.active {
		color: var(--primary);
		background: var(--primary-soft);
		font-weight: 600;
		border-left: 3px solid var(--primary);
		padding-left: 7px;
	}

	.posts-main {
		flex: 1;
	}

	.posts-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
	}

	.post-card {
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: 10px;
		padding: 1.5rem;
		transition: all 0.2s;
	}

	.post-card:hover {
		border-color: var(--primary);
		box-shadow: 0 8px 30px rgba(0, 84, 179, 0.1);
		transform: translateY(-2px);
	}

	.post-header {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	.category-badge {
		background: var(--primary-soft);
		color: var(--primary-dark);
		font-size: 11px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		padding: 3px 10px;
		border-radius: 99px;
	}

	.date {
		font-size: 12px;
		color: var(--ink-faint);
		font-family: var(--font-mono);
	}

	.post-card h2 {
		font-size: 1.4rem;
		font-weight: 700;
		color: var(--ink-strong);
		margin: 0 0 0.75rem;
		line-height: 1.35;
	}

	.post-card h2 a {
		color: inherit;
		text-decoration: none;
	}

	.post-card h2 a:hover {
		color: var(--primary);
	}

	.post-description {
		font-size: 14px;
		color: var(--ink-muted);
		line-height: 1.6;
		margin: 0 0 1rem;
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin-bottom: 1rem;
	}

	/* 🎯 NEW: Make tags clickable with hover state */
	.tag-link {
		text-decoration: none;
		transition: all 0.15s;
	}

	.tag-link:hover .tag {
		background: var(--primary);
		color: white;
	}

	.tag {
		font-size: 11px;
		background: var(--primary-soft);
		color: var(--primary);
		padding: 3px 8px;
		border-radius: 4px;
		font-weight: 600;
		transition: all 0.15s;
		cursor: pointer;
	}

	.read-more {
		display: inline-block;
		color: var(--primary);
		text-decoration: none;
		font-weight: 500;
		font-size: 13px;
		transition: all 0.2s;
	}

	.read-more:hover {
		transform: translateX(4px);
	}

	/* 🎯 NEW: Enhanced empty state */
	.empty-state {
		text-align: center;
		padding: 3rem;
		color: var(--ink-muted);
	}

	.empty-state strong {
		color: var(--primary);
		font-weight: 700;
	}

	.empty-state-link {
		display: inline-block;
		margin-top: 1rem;
		padding: 8px 16px;
		background: var(--primary);
		color: white;
		text-decoration: none;
		border-radius: 6px;
		font-size: 13px;
		font-weight: 600;
		transition: all 0.2s;
	}

	.empty-state-link:hover {
		transform: translateY(-2px);
		box-shadow: 0 4px 12px rgba(0, 84, 179, 0.3);
	}

	@media (max-width: 768px) {
		.content-area {
			grid-template-columns: 1fr;
		}

		.sidebar {
			position: static;
		}

		.section-header h1 {
			font-size: 1.8rem;
		}

		.filter-box {
			display: none;
		}
	}
</style>
